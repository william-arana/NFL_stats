// Only needed if you ever deploy the Worker from the command line (npx wrangler deploy, run inside worker/).
// The dashboard deploy doesn't use this file. Secrets (ANTHROPIC_API_KEY, PASSCODE) are never stored here;
// set them with `npx wrangler secret put ANTHROPIC_API_KEY` and `npx wrangler secret put PASSCODE`.
{
  "name": "nfl-stats-ask",
  "main": "ask-worker.js",
  "compatibility_date": "2025-09-01",
  "vars": {
    "MODEL": "claude-sonnet-5-5"
  }
}
